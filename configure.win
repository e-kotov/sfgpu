#!/bin/sh
set -eu
for option in "$@"; do
  case "$option" in
    --enable-cuda) printf '%s\n' 'sfgpu: on Windows, CUDA acceleration is enabled dynamically via sfgpu::sfgpu_install_cuda()' ;;
    --disable-cuda) ;;
    *) printf '%s\n' "Unknown configure option: $option" >&2 ; exit 1 ;;
  esac
done
rm -f src/*.o src/*.dll
rm -f src/*.mm
cat > src/Makevars.win <<'EOF'
CXX_STD = CXX17
PKG_CPPFLAGS = -DSFGPU_CUDA_DYNAMIC
OBJECTS = init.o distance.o radius.o cuda_loader.o
EOF
